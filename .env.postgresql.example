# PostgreSQL Database Configuration
# After migration, add these to your .env file

# PostgreSQL Connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=streaming
PG_USER=postgres
PG_PASSWORD=your_secure_password_here

# Database type (sqlite or postgresql)
DB_TYPE=postgresql

# Optional: Keep SQLite path for backup/migration purposes
SQLITE_DB_PATH=./data/streaming.db

# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Secret (keep your existing one)
JWT_SECRET=your_jwt_secret_here

# Other existing environment variables...
# (Copy from your current .env file)
